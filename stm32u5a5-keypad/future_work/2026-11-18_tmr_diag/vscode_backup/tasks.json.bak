{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build keypad",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Flash keypad (ST-Link)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/flash.ps1"
      ],
      "dependsOn": "Build keypad",
      "problemMatcher": []
    },
    {
      "label": "Flash keypad (USB DFU)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/flash-usb.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Flash existing HEX over USB DFU and verify; enter BOOT/RST mode first."
    },
    {
      "label": "Build + Flash keypad (USB DFU)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build keypad",
        "Flash keypad (USB DFU)"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Build firmware, then flash and verify via USB DFU."
    }
  ]
}
