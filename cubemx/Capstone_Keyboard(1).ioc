# ============================================================
# ADC1 - 4-channel scan with DMA circular
#
# Pin -> Channel mapping:
#   PC0 -> ADC1_IN1 -> Rank 1 (MUX output for cols 1,5,9,13)
#   PC1 -> ADC1_IN2 -> Rank 2 (MUX output for cols 2,6,10,14)
#   PC2 -> ADC1_IN3 -> Rank 3 (MUX output for cols 3,7,11,15)
#   PC3 -> ADC1_IN4 -> Rank 4 (MUX output for cols 4,8,12,16)
#
# Resolution: 14-bit (U595 ADC1 hardware maximum)
# Clock source: ADC kernel clock asynchronous, 80MHz (/2 of HCLK)
# Sampling time: 640.5 cycles @ 80MHz = ~8us per channel
#   TMR2615F datasheet: output settles in <1us after power-on
#   MUX switching: ~150ns propagation (CD74HC4067 typical)
#   640 cycles is very conservative -- safe for bring-up,
#   can reduce to 47.5 cycles in production for max throughput
# Trigger: software start (firmware controls when to sample)
# DMA: circular into uint16_t adc_buf[4], always fresh
# ============================================================
ADC1.IPParameters=Resolution,ClockPrescaler,ScanConvMode,ContinuousConvMode,DiscontinuousConvMode,ExternalTrigConv,ExternalTrigConvEdge,DMAContinuousRequests,EOCSelection,NbrOfConversion,NbrOfConversionFlag,master,SamplingTimeCommon1,Channel-0\ChannelRegularConversion,Channel-0\Rank,Channel-0\SamplingTime,Channel-1\ChannelRegularConversion,Channel-1\Rank,Channel-1\SamplingTime,Channel-2\ChannelRegularConversion,Channel-2\Rank,Channel-2\SamplingTime,Channel-3\ChannelRegularConversion,Channel-3\Rank,Channel-3\SamplingTime

ADC1.Resolution=ADC_RESOLUTION_14B
ADC1.ClockPrescaler=ADC_CLOCK_ASYNC_DIV1
ADC1.ScanConvMode=1
ADC1.ContinuousConvMode=DISABLE
ADC1.DiscontinuousConvMode=DISABLE
ADC1.ExternalTrigConv=ADC_SOFTWARE_START
ADC1.ExternalTrigConvEdge=ADC_EXTERNALTRIGCONVEDGE_NONE
ADC1.DMAContinuousRequests=ENABLE
ADC1.EOCSelection=ADC_EOC_SEQ_CONV
ADC1.NbrOfConversion=4
ADC1.NbrOfConversionFlag=1
ADC1.master=1
ADC1.SamplingTimeCommon1=ADC_SAMPLETIME_640CYCLES_5

ADC1.Channel-0\ChannelRegularConversion=ADC_CHANNEL_1
ADC1.Channel-0\Rank=ADC_REGULAR_RANK_1
ADC1.Channel-0\SamplingTime=ADC_SAMPLINGTIME_COMMON_1

ADC1.Channel-1\ChannelRegularConversion=ADC_CHANNEL_2
ADC1.Channel-1\Rank=ADC_REGULAR_RANK_2
ADC1.Channel-1\SamplingTime=ADC_SAMPLINGTIME_COMMON_1

ADC1.Channel-2\ChannelRegularConversion=ADC_CHANNEL_3
ADC1.Channel-2\Rank=ADC_REGULAR_RANK_3
ADC1.Channel-2\SamplingTime=ADC_SAMPLINGTIME_COMMON_1

ADC1.Channel-3\ChannelRegularConversion=ADC_CHANNEL_4
ADC1.Channel-3\Rank=ADC_REGULAR_RANK_4
ADC1.Channel-3\SamplingTime=ADC_SAMPLINGTIME_COMMON_1

# ============================================================
# TIM3 - Rotary encoder quadrature decode
#
# PC6 = TIM3_CH1 = ENC_CLK (A phase)
# PC7 = TIM3_CH2 = ENC_DT  (B phase)
#
# EncoderMode TI12: counts edges on BOTH channels -> 4x resolution
#   One physical detent = typically 4 counts (depends on encoder)
#   Divide by 4 in firmware for detent-level steps
# Period 65535: full 16-bit counter, wraps at 0 and 65535
#   Firmware handles wrap-around for signed delta calculation
# IC Filter = 8: 8 consecutive samples at TIM clock must agree
#   Eliminates contact bounce on mechanical encoder
# PULLUP on both pins: encoder outputs are open-drain or 3-state
# ============================================================
TIM3.IPParameters=EncoderMode,Prescaler,Period,Channel-CH1,IC1Polarity,IC1Selection,IC1Prescaler,IC1Filter,Channel-CH2,IC2Polarity,IC2Selection,IC2Prescaler,IC2Filter

TIM3.EncoderMode=TIM_ENCODERMODE_TI12
TIM3.Prescaler=0
TIM3.Period=65535

TIM3.Channel-CH1=TIM_CHANNEL_1
TIM3.IC1Polarity=TIM_ICPOLARITY_RISING
TIM3.IC1Selection=TIM_ICSELECTION_DIRECTTI
TIM3.IC1Prescaler=TIM_ICPSC_DIV1
TIM3.IC1Filter=8

TIM3.Channel-CH2=TIM_CHANNEL_2
TIM3.IC2Polarity=TIM_ICPOLARITY_RISING
TIM3.IC2Selection=TIM_ICSELECTION_DIRECTTI
TIM3.IC2Prescaler=TIM_ICPSC_DIV1
TIM3.IC2Filter=8

# ============================================================
# SPI2 - SK6812MINI-E LED chain (16 LEDs)
#
# PB15 = SPI2_MOSI = LED_DATA (1-wire output only)
#
# APB1 = 160MHz, BaudRatePrescaler=32 -> SPI CLK = 5MHz
# Each SPI bit period = 200ns
# WS2812/SK6812 bit encoding using 3 SPI bits per LED bit:
#   LED 0-bit -> SPI 0b100 -> 200ns H, 400ns L  (T0H=200, T0L=400)
#   LED 1-bit -> SPI 0b110 -> 400ns H, 200ns L  (T1H=400, T1L=200)
# SK6812 datasheet tolerances: T0H 150-450ns, T1H 450-750ns
# Reset: >80us = send >=40 zero bytes between frames
#
# Encoding: each SK6812 GRB byte -> 3 SPI bytes (24 SPI bits)
# Frame size for 16 LEDs: 16 * 3 colours * 3 bytes = 144 SPI bytes
#                       + 40 reset bytes = 184 bytes total
# ============================================================
SPI2.IPParameters=VirtualType,Mode,Direction,DataSize,FirstBit,TIMode,CRCCalculation,NSS,BaudRatePrescaler,NSSPMode,NSSPolarity

SPI2.VirtualType=VM_MASTER
SPI2.Mode=SPI_MODE_MASTER
SPI2.Direction=SPI_DIRECTION_1LINE
SPI2.DataSize=SPI_DATASIZE_8BIT
SPI2.FirstBit=SPI_FIRSTBIT_MSB
SPI2.TIMode=SPI_TIMODE_DISABLE
SPI2.CRCCalculation=SPI_CRCCALCULATION_DISABLE
SPI2.NSS=SPI_NSS_SOFT
SPI2.BaudRatePrescaler=SPI_BAUDRATEPRESCALER_32
SPI2.NSSPMode=SPI_NSS_PULSE_DISABLE
SPI2.NSSPolarity=SPI_NSS_POLARITY_LOW

# ============================================================
# USART1 - Debug UART
#
# PA9  = USART1_TX
# PA10 = USART1_RX
#
# 115200 8N1, no flow control
# printf()-redirected via syscalls.c __io_putchar override
# Use for: ADC raw value printing, key event logging,
#          TMR threshold calibration output
# ============================================================
USART1.IPParameters=VirtualMode-Asynchronous,BaudRate,WordLength,StopBits,Parity,HwFlowCtl,OverSampling

USART1.VirtualMode-Asynchronous=VM_ASYNC
USART1.BaudRate=115200
USART1.WordLength=UART_WORDLENGTH_8B
USART1.StopBits=UART_STOPBITS_1
USART1.Parity=UART_PARITY_NONE
USART1.HwFlowCtl=UART_HWCONTROL_NONE
USART1.OverSampling=UART_OVERSAMPLING_16

# ============================================================
# USB OTG HS - HID Keyboard device
#
# PA11 = USB_OTG_HS_DM
# PA12 = USB_OTG_HS_DP
#
# U595 has integrated HS PHY (no external ULPI chip needed)
# Device-only mode
# USB middleware (HID class) configured separately in CubeIDE
# Runs at Full Speed (12Mbps) for HID -- HS PHY supports FS
# ============================================================
USB_OTG_HS.IPParameters=VirtualMode,PhyInterface
USB_OTG_HS.VirtualMode=Device_Only
USB_OTG_HS.PhyInterface=USB_OTG_EMBEDDED_PHY

# ============================================================
# OCTOSPI1 - W25Q128JVS 16MB NOR Flash (QSPI 4-line mode)
#
# PA2  = OCTOSPIM_P1_NCS  (active-low chip select)
# PA3  = OCTOSPIM_P1_CLK  (clock)
# PC5  = OCTOSPIM_P1_IO0  (MOSI in SPI, DQ0 in QSPI)
# PC4  = OCTOSPIM_P1_IO1  (MISO in SPI, DQ1 in QSPI)
# PA7  = OCTOSPIM_P1_IO2  (WP# in SPI,  DQ2 in QSPI)
# PA6  = OCTOSPIM_P1_IO3  (HOLD# in SPI,DQ3 in QSPI)
#
# DeviceSize=23: 2^(23+1) = 16,777,216 bytes = 16MB (W25Q128)
# ClockPrescaler=1: OSPI_CLK = HCLK/(1+1) = 80MHz
# CPOL/CPHA mode 0 (SPI mode 0) matches W25Q128 default
# SampleShifting half-cycle: compensates propagation delay
# Used for storing: key maps, LED profiles, calibration data
# ============================================================
OCTOSPI1.IPParameters=FifoThresholdByte,DualQuad,MemoryType,DeviceSize,ChipSelectHighTimeCycle,FreeRunningClock,WrapSize,ClockMode,ClockPrescaler,SampleShifting,DelayHoldQuarterCycle,ChipSelectBoundary

OCTOSPI1.FifoThresholdByte=4
OCTOSPI1.DualQuad=HAL_OSPI_DUALQUAD_DISABLE
OCTOSPI1.MemoryType=HAL_OSPI_MEMTYPE_MICRON
OCTOSPI1.DeviceSize=23
OCTOSPI1.ChipSelectHighTimeCycle=2
OCTOSPI1.FreeRunningClock=HAL_OSPI_FREERUNCLK_DISABLE
OCTOSPI1.WrapSize=HAL_OSPI_WRAP_NOT_SUPPORTED
OCTOSPI1.ClockMode=HAL_OSPI_CLOCK_MODE_0
OCTOSPI1.ClockPrescaler=1
OCTOSPI1.SampleShifting=HAL_OSPI_SAMPLE_SHIFTING_HALFCYCLE
OCTOSPI1.DelayHoldQuarterCycle=HAL_OSPI_DHQC_DISABLE
OCTOSPI1.ChipSelectBoundary=0

# ============================================================
# GPDMA1 - STM32U5 General Purpose DMA (replaces legacy DMA1/2)
#
# Channel 0: ADC1 -> memory
#   Peripheral: ADC1 data register (fixed address)
#   Memory: uint16_t adc_buf[4] (incrementing)
#   Width: 16-bit halfword both sides
#   Mode: circular (continuously overwrites buffer)
#   Priority: HIGH (sensor data must not be dropped)
#
# Channel 1: memory -> SPI2 TX
#   Peripheral: SPI2 TXDR (fixed address)
#   Memory: uint8_t led_buf[184] (incrementing)
#   Width: 8-bit byte both sides
#   Mode: normal (single shot per LED frame)
#   Priority: MEDIUM
# ============================================================
GPDMA1.IPParameters=Channel-0\Direction,Channel-0\Request,Channel-0\Priority,Channel-0\SrcDataWidth,Channel-0\DestDataWidth,Channel-0\SrcAddrInc,Channel-0\DestAddrInc,Channel-0\Mode,Channel-1\Direction,Channel-1\Request,Channel-1\Priority,Channel-1\SrcDataWidth,Channel-1\DestDataWidth,Channel-1\SrcAddrInc,Channel-1\DestAddrInc,Channel-1\Mode

GPDMA1.Channel-0\Direction=GPDMA_CHANNEL_DIRECTION_P2M
GPDMA1.Channel-0\Request=GPDMA1_REQUEST_ADC1
GPDMA1.Channel-0\Priority=DMA_HIGH_PRIORITY
GPDMA1.Channel-0\SrcDataWidth=DMA_SRC_DATAWIDTH_HALFWORD
GPDMA1.Channel-0\DestDataWidth=DMA_DEST_DATAWIDTH_HALFWORD
GPDMA1.Channel-0\SrcAddrInc=DMA_SINC_FIXED
GPDMA1.Channel-0\DestAddrInc=DMA_DINC_INCREMENT
GPDMA1.Channel-0\Mode=DMA_LINKEDLIST_CIRCULAR

GPDMA1.Channel-1\Direction=GPDMA_CHANNEL_DIRECTION_M2P
GPDMA1.Channel-1\Request=GPDMA1_REQUEST_SPI2_TX
GPDMA1.Channel-1\Priority=DMA_MEDIUM_PRIORITY
GPDMA1.Channel-1\SrcDataWidth=DMA_SRC_DATAWIDTH_BYTE
GPDMA1.Channel-1\DestDataWidth=DMA_DEST_DATAWIDTH_BYTE
GPDMA1.Channel-1\SrcAddrInc=DMA_SINC_INCREMENT
GPDMA1.Channel-1\DestAddrInc=DMA_DINC_FIXED
GPDMA1.Channel-1\Mode=DMA_NORMAL

# ============================================================
# NVIC - Interrupt configuration
# NVIC_PRIORITYGROUP_4: 4 preemption bits, 0 sub-priority bits
# Preemption priority 0=highest, 15=lowest
#
#  0 - ADC1 conv complete (TMR scan done, data ready)
#  0 - GPDMA CH0 (ADC DMA transfer complete)
#  0 - USB OTG HS (HID report timing critical)
#  1 - GPDMA CH1 (SPI LED frame done, re-arm)
#  2 - TIM3 (encoder overflow/underflow)
#  2 - USART1 (debug RX)
#  3 - EXTI9_5 (encoder switch PC8, debounced in ISR)
# ============================================================
NVIC.PriorityGroup=NVIC_PRIORITYGROUP_4
NVIC.ForceEnableDMAVector=true

NVIC.ADC1_IRQn=true\:0\:0\:false\:false\:true\:true\:true\:true
NVIC.GPDMA1_Channel0_IRQn=true\:0\:0\:false\:false\:true\:true\:true\:true
NVIC.GPDMA1_Channel1_IRQn=true\:1\:0\:false\:false\:true\:true\:true\:true
NVIC.USB_OTG_HS_IRQn=true\:0\:0\:false\:false\:true\:true\:true\:true
NVIC.TIM3_IRQn=true\:2\:0\:false\:false\:true\:true\:true\:true
NVIC.USART1_IRQn=true\:2\:0\:false\:false\:true\:true\:true\:true
NVIC.EXTI9_5_IRQn=true\:3\:0\:false\:false\:true\:true\:true\:true

