# ============================================================
# RCC - HSE 25MHz -> PLL1 -> 160MHz SYSCLK
# USB clock from HSI48 (internal 48MHz RC + CRS)
#
# PLL1 math:
#   VCO_in  = HSE(25MHz) / M(5) = 5MHz
#   VCO_out = 5MHz x N(64)      = 320MHz
#   SYSCLK  = VCO / R(2)        = 160MHz  (U595 max)
#   PLLQ    = VCO / Q(2)        = 160MHz  (not used for USB)
#
# USB: sourced from HSI48 trimmed by CRS using USB SOF packets
#      most accurate USB clock source on STM32U5
# ADC: kernel clock = HCLK = 160MHz, prescaler /2 = 80MHz
# ============================================================
RCC.HSEState=RCC_HSE_ON
RCC.HSE_VALUE=25000000
RCC.HSIState=RCC_HSI_OFF
RCC.HSI48State=RCC_HSI48_ON
RCC.LSEState=RCC_LSE_OFF
RCC.LSIState=RCC_LSI_OFF
RCC.MSIState=RCC_MSI_OFF

RCC.PLLMState=RCC_PLL_ON
RCC.PLLSourceVirtual=RCC_PLLSOURCE_HSE
RCC.PLLM=5
RCC.PLLN=64
RCC.PLLP=2
RCC.PLLQ=2
RCC.PLLR=2

RCC.SYSCLKSource=RCC_SYSCLKSOURCE_PLLCLK
RCC.AHBCLKDivider=RCC_SYSCLK_DIV1
RCC.APB1CLKDivider=RCC_HCLK_DIV1
RCC.APB2CLKDivider=RCC_HCLK_DIV1
RCC.APB3CLKDivider=RCC_HCLK_DIV1

RCC.ICLK48MHzSourceVirtual=RCC_ICLK48MHZSOURCE_HSI48

RCC.SYSCLKFreq_VALUE=160000000
RCC.HCLKFreq_Value=160000000
RCC.AHB1Freq_Value=160000000
RCC.AHB2Freq_Value=160000000
RCC.APB1Freq_Value=160000000
RCC.APB2Freq_Value=160000000
RCC.APB3Freq_Value=160000000
RCC.CortexFreq_Value=160000000
RCC.FCLKCortexFreq_Value=160000000
RCC.TimSysFreq_Value=160000000
RCC.PLLFreq_Value=160000000
RCC.MCO1PinFreq_Value=160000000
RCC.USB48MFreq_Value=48000000
RCC.ADCFreq_Value=80000000

RCC.IPParameters=HSEState,HSE_VALUE,HSIState,HSI48State,LSEState,LSIState,MSIState,PLLMState,PLLSourceVirtual,PLLM,PLLN,PLLP,PLLQ,PLLR,SYSCLKSource,AHBCLKDivider,APB1CLKDivider,APB2CLKDivider,APB3CLKDivider,ICLK48MHzSourceVirtual,SYSCLKFreq_VALUE,HCLKFreq_Value,AHB1Freq_Value,AHB2Freq_Value,APB1Freq_Value,APB2Freq_Value,APB3Freq_Value,CortexFreq_Value,FCLKCortexFreq_Value,TimSysFreq_Value,PLLFreq_Value,MCO1PinFreq_Value,USB48MFreq_Value,ADCFreq_Value

