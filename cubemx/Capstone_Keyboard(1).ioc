# PC7 - TIM3_CH2 = Encoder B phase (ENC_DT)
PC7.Signal=TIM3_CH2
PC7.Mode=Encoder_Mode_TI12
PC7.GPIO_Label=ENC_DT
PC7.GPIO_PuPd=GPIO_PULLUP

# PC8 - Encoder push switch (EXTI falling, pull-up)
PC8.Signal=GPXTI8
PC8.GPIO_Label=ENC_SW
PC8.GPIO_ModeDefaultEXTI=GPIO_MODE_IT_FALLING
PC8.GPIO_PuPd=GPIO_PULLUP
PC8.Locked=true

# PC9 - Matrix ROW_1 (output, push-pull)
PC9.Signal=GPIO_Output
PC9.GPIO_Label=ROW_1
PC9.GPIO_ModeDefaultEXTI=GPIO_MODE_OUTPUT_PP
PC9.GPIO_PuPd=GPIO_NOPULL
PC9.GPIO_Speed=GPIO_SPEED_FREQ_LOW
PC9.GPIO_InitDefaultValue=GPIO_PIN_RESET
PC9.Locked=true

# PC10 - Matrix ROW_2 (output, push-pull)
PC10.Signal=GPIO_Output
PC10.GPIO_Label=ROW_2
PC10.GPIO_ModeDefaultEXTI=GPIO_MODE_OUTPUT_PP
PC10.GPIO_PuPd=GPIO_NOPULL
PC10.GPIO_Speed=GPIO_SPEED_FREQ_LOW
PC10.GPIO_InitDefaultValue=GPIO_PIN_RESET
PC10.Locked=true

# PC11 - Matrix ROW_3 (output, push-pull)
PC11.Signal=GPIO_Output
PC11.GPIO_Label=ROW_3
PC11.GPIO_ModeDefaultEXTI=GPIO_MODE_OUTPUT_PP
PC11.GPIO_PuPd=GPIO_NOPULL
PC11.GPIO_Speed=GPIO_SPEED_FREQ_LOW
PC11.GPIO_InitDefaultValue=GPIO_PIN_RESET
PC11.Locked=true

# PH0 / PH1 - HSE 25MHz crystal
PH0-OSC_IN.Signal=RCC_OSC_IN
PH0-OSC_IN.Mode=HSE-External-Oscillator
PH1-OSC_OUT.Signal=RCC_OSC_OUT
PH1-OSC_OUT.Mode=HSE-External-Oscillator
